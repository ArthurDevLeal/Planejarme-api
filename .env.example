# Copie para .env e preencha. Nunca commite o .env.

# Postgres (Prisma 7 com @prisma/adapter-pg)
DATABASE_URL=postgres://usuario:senha@localhost:5432/planejarme

# Porta local da API (padrão 3001)
PORT=3001

# Segredo para assinar os JWT de sessão. Use um valor longo e aleatório.
JWT_SECRET=

# Supabase Storage (upload de materiais). A chave secreta só fica no servidor.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=materials

# E-mail (Resend) para recuperação de senha. Sem a chave, fora de produção o link só aparece no log da API.
RESEND_API_KEY=
EMAIL_FROM=Planejar.me <onboarding@resend.dev>
# Endereço do web usado no link do e-mail
WEB_URL=http://localhost:3000

# Login com Google/GitHub. Sem as chaves, o botão volta para o login com aviso.
# URL de retorno a cadastrar no provedor: <API_URL>/auth/oauth/google/callback e .../github/callback
API_URL=http://localhost:3001
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cron diário da Vercel (notificações). A Vercel envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Abacate Pay (assinatura Pro). Use SOMENTE chave de Dev mode aqui (abc_dev_...); a API recusa outra chave fora de produção.
# Produtos de teste: npm run abacatepay:setup. Webhook: POST /webhooks/abacatepay, precisa de URL HTTPS pública (ver ABACATEPAY-GO-LIVE.md).
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_PRODUCT_PRO_MONTHLY=
ABACATEPAY_PRODUCT_PRO_YEARLY=
# Meios da assinatura. Pix recorrente só depois que a Abacate Pay habilitar o Pix Automático na loja; aí use PIX,CARD.
ABACATEPAY_SUBSCRIPTION_METHODS=CARD

# Afiliados: e-mails (separados por vírgula) que acessam /dashboard/admin/afiliados e o percentual de comissão (padrão 30).
ADMIN_EMAILS=
AFFILIATE_COMMISSION_PCT=
